# ==============================================================================
# EcoSentinel Environment Configuration (Example Template)
# ==============================================================================
# Copy this file to `.env` in the root (or respective frontend/backend directories)
# and adjust values for your local development environment.
# NEVER commit actual secrets, passwords, or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Settings (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME="EcoSentinel"
VERSION="0.1.0"
API_PREFIX="/api"
HOST="127.0.0.1"
PORT=8000
DEBUG=True

# Allowed CORS origins for local frontend communication (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# OpenAQ API v3 Provider Configuration
# ------------------------------------------------------------------------------
# Register for a free API key at: https://explore.openaq.org/register
# Paste your generated key below to query live Indian air quality monitoring stations.
# Note: The backend will run without a key, but live data queries will report MISSING_API_KEY.
OPENAQ_API_KEY=""
OPENAQ_BASE_URL="https://api.openaq.org/v3"
OPENAQ_TIMEOUT_SECONDS=10.0
STALE_DATA_THRESHOLD_HOURS=24


# ------------------------------------------------------------------------------
# Planned Database Configuration (PostgreSQL) - Pending Future Milestones
# ------------------------------------------------------------------------------
# Note: A running database is NOT required for Milestone 1.
# The following placeholder values illustrate the planned connection structure.
POSTGRES_USER=ecosentinel_user
POSTGRES_PASSWORD=replace_with_secure_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecosentinel_db
# DATABASE_URL=postgresql+psycopg://ecosentinel_user:replace_with_secure_dev_password@localhost:5432/ecosentinel_db

# ------------------------------------------------------------------------------
# Frontend Settings (Vite + React)
# ------------------------------------------------------------------------------
# In Vite, variables exposed to the client must be prefixed with VITE_
VITE_API_BASE_URL="http://localhost:8000"
VITE_APP_TITLE="EcoSentinel"
VITE_APP_TAGLINE="Evidence-based environmental intelligence"
